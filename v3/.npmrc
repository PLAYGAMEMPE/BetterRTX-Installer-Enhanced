# ============================================================
#  pnpm v11 — Security & Isolation Configuration
#  BetterRTX Easy Installer
# ============================================================

# --- Engine Enforcement --------------------------------------
# Fail if the Node or pnpm version doesn't satisfy "engines" in package.json
# Node 22 LTS is installed by setup-env.bat; no per-project download needed.
engine-strict=true

# --- Package Integrity & Store --------------------------------
# Always verify the integrity of packages from the content-addressable store.
# Detects tampering with cached packages.
verify-store-integrity=true

# --- Dependency Resolution ------------------------------------
# Use the highest compatible version of each package to pick up security patches.
resolution-mode=highest

# --- Peer Dependencies ----------------------------------------
# Deduplicate to reduce the attack surface of transitive dependencies.
dedupe-peer-dependents=true
# Start lenient; harden to `true` once all peer warnings are resolved.
strict-peer-dependencies=false

# --- Security Audit -------------------------------------------
# Disabled auto-audit (blocks the install process with a network call).
# Run manually when needed: pnpm --dir v3 audit
audit=false
audit-level=high

# --- Lockfile & Reproducibility --------------------------------
# Prefer the frozen lockfile in CI environments (set by default when
# CI=true); prevents accidental lockfile drift in automated builds.
prefer-frozen-lockfile=true

# --- Side Effects Cache ---------------------------------------
# Cache outputs of lifecycle scripts to avoid redundant rebuilds.
side-effects-cache=true

# --- Registry Hardening ----------------------------------------
# Always use the official registry over HTTPS.
registry=https://registry.npmjs.org/

# --- SSL/TLS --------------------------------------------------
strict-ssl=true

# --- Telemetry ------------------------------------------------
update-notifier=false
