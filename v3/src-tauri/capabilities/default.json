{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:default",
    "fs:default",
    "upload:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "C:\\**" },
        { "path": "D:\\**" },
        { "path": "E:\\**" }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "C:\\**" },
        { "path": "D:\\**" },
        { "path": "E:\\**" }
      ]
    },
    "shell:allow-execute",
    "shell:allow-open"
  ]
}